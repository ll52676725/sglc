{
  "name": "shiguangbu",
  "private": true,
  "version": "1.0.0",
  "description": "时光簿 - 个人记忆管理应用",
  "author": "时光簿团队",
  "type": "module",
  "main": "dist/electron/main.js",
  "scripts": {
    "client:dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "check": "tsc --noEmit",
    "server:dev": "nodemon",
    "dev": "concurrently \"npm run client:dev\" \"npm run server:dev\"",
    "electron:dev": "concurrently \"npm run server:dev\" \"wait-on http://localhost:6666 && electron .\"",
    "electron:build-client": "vite build --outDir dist/client",
    "electron:build-electron": "tsx scripts/build-electron.ts",
    "electron:build-all": "npm run electron:build-client && npm run electron:build-electron",
    "electron:pack": "npm run electron:build-all && electron-builder --win",
    "electron:generate-icons": "node generate-icons.mjs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "docx": "^9.7.1",
    "dotenv": "^17.2.1",
    "express": "^4.21.2",
    "file-saver": "^2.0.5",
    "fluent-ffmpeg": "^2.1.3",
    "hls.js": "^1.6.16",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.511.0",
    "multer": "^1.4.5-lts.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.3.0",
    "sql.js": "^1.11.0",
    "tailwind-merge": "^3.0.2",
    "uuid": "^11.0.5",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/file-saver": "^2.0.7",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.15.30",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/uuid": "^10.0.0",
    "@vercel/node": "^5.3.6",
    "@vitejs/plugin-react": "^4.4.1",
    "asar": "^3.2.0",
    "autoprefixer": "^10.5.0",
    "babel-plugin-react-dev-locator": "^1.0.0",
    "concurrently": "^9.2.0",
    "electron": "^42.3.3",
    "electron-builder": "^26.15.2",
    "esbuild": "^0.25.5",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "nodemon": "^3.1.10",
    "postcss": "^8.5.15",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.22.4",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.30.1",
    "vite": "^6.3.5",
    "vite-plugin-trae-solo-badge": "^1.0.0",
    "vite-tsconfig-paths": "^5.1.4"
  }
}
